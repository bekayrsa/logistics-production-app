{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".indexOn": ["email", "role"],
      "$uid": {
        ".write": "root.child('users').child(auth.token.email.replace('.', '_')).child('role').val() == 'admin' || auth.token.email.replace('.', '_') == $uid"
      }
    },
    "sites": {
      ".indexOn": ["status"]
    },
    "trucks": {
      ".indexOn": ["status", "type"]
    },
    "captures": {
      ".indexOn": ["date", "siteId", "truckId"]
    },
    "production": {
      ".indexOn": ["date", "siteId"]
    }
  }
}
