{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["email", "role", "companyId"],
      "$user_id": {
        ".write": "auth != null && (auth.token.email.replace('.', '_').replace('@', '_') == $user_id || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin' || (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'admin' && ((newData.exists() && root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('companyId').val() == newData.child('companyId').val()) || (!newData.exists() && root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('companyId').val() == data.child('companyId').val()))))"
      }
    },
    "companies": {
      "$companyId": {
        ".read": "auth != null && (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('companyId').val() == $companyId || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin')",
        ".write": "auth != null && (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin' || (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('companyId').val() == $companyId && root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'admin'))",
        "sites": { 
          ".indexOn": ["status"],
          "$siteId": {
            ".write": "auth != null && (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'admin' || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin')"
          }
        },
        "trucks": { ".indexOn": ["status", "type"] },
        "captures": { 
          ".indexOn": ["date", "siteId", "truckId"],
          "$captureId": {
            ".write": "auth != null && (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'admin' || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin' || (newData.exists() && root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('assignedSites').child(newData.child('siteId').val()).exists()))"
          }
        },
        "production": { 
          ".indexOn": ["date", "siteId"],
          "$prodId": {
            ".write": "auth != null && (root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'admin' || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'manager' || root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('role').val() == 'superAdmin' || (newData.exists() && root.child('users').child(auth.token.email.replace('.', '_').replace('@', '_')).child('assignedSites').child(newData.child('siteId').val()).exists()))"
          }
        },
        "auditLogs": {
           ".indexOn": ["timestamp", "action", "entityType"]
        }
      }
    }
  }
}