{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      ".indexOn": ["email", "role"],
      "$user_id": {
        ".write": "auth.token.email == 'admin@miningsense.com' || auth.token.email.replace('@', '_').replace('.', '_') == $user_id"
      }
    },
    "sites": {
      ".indexOn": ["status"]
    },
    "trucks": {
      ".indexOn": ["status", "type"]
    },
    "captures": {
      ".indexOn": ["date", "siteId", "truckId"]
    },
    "production": {
      ".indexOn": ["date", "siteId"]
    }
  }
}
